[
  {
    "id": "hostname",
    "title": "Device setup",
    "device": "R1",
    "task": "Configure the router hostname and save the configuration.",
    "commands": [
      "enable",
      "configure terminal",
      "hostname R1",
      "end",
      "copy running-config startup-config"
    ]
  },
  {
    "id": "ipv4",
    "title": "IPv4 interface",
    "device": "Router",
    "task": "Assign 192.168.10.1/24 to GigabitEthernet0/0 and enable it.",
    "commands": [
      "enable",
      "configure terminal",
      "interface gigabitethernet0/0",
      "ip address 192.168.10.1 255.255.255.0",
      "no shutdown",
      "end",
      "show ip interface brief"
    ]
  },
  {
    "id": "vlan",
    "title": "VLAN access port",
    "device": "Switch",
    "task": "Create VLAN 10 named SALES and assign FastEthernet0/1 as an access port.",
    "commands": [
      "enable",
      "configure terminal",
      "vlan 10",
      "name SALES",
      "exit",
      "interface fastethernet0/1",
      "switchport mode access",
      "switchport access vlan 10",
      "end",
      "show vlan brief"
    ]
  },
  {
    "id": "trunk",
    "title": "802.1Q trunk",
    "device": "Switch",
    "task": "Configure GigabitEthernet0/1 as a trunk allowing VLANs 10 and 20.",
    "commands": [
      "enable",
      "configure terminal",
      "interface gigabitethernet0/1",
      "switchport mode trunk",
      "switchport trunk allowed vlan 10,20",
      "end",
      "show interfaces trunk"
    ]
  },
  {
    "id": "route",
    "title": "Static routing",
    "device": "Router",
    "task": "Configure a route to 10.20.0.0/24 via 192.168.1.2.",
    "commands": [
      "enable",
      "configure terminal",
      "ip route 10.20.0.0 255.255.255.0 192.168.1.2",
      "end",
      "show ip route"
    ]
  },
  {
    "id": "ospf",
    "title": "Single-area OSPF",
    "device": "Router",
    "task": "Start OSPF process 1 and advertise 192.168.1.0/24 in area 0.",
    "commands": [
      "enable",
      "configure terminal",
      "router ospf 1",
      "network 192.168.1.0 0.0.0.255 area 0",
      "end",
      "show ip protocols"
    ]
  },
  {
    "id": "acl",
    "title": "Standard ACL",
    "device": "Router",
    "task": "Create ACL 10 permitting 192.168.10.0/24 and apply it inbound on G0/0.",
    "commands": [
      "enable",
      "configure terminal",
      "access-list 10 permit 192.168.10.0 0.0.0.255",
      "interface gigabitethernet0/0",
      "ip access-group 10 in",
      "end",
      "show access-lists"
    ]
  },
  {
    "id": "dhcp",
    "title": "DHCP server",
    "device": "Router",
    "task": "Exclude .1 through .10, create pool LAN for 192.168.10.0/24, and set gateway .1.",
    "commands": [
      "enable",
      "configure terminal",
      "ip dhcp excluded-address 192.168.10.1 192.168.10.10",
      "ip dhcp pool LAN",
      "network 192.168.10.0 255.255.255.0",
      "default-router 192.168.10.1",
      "end",
      "show ip dhcp pool"
    ]
  },
  {
    "id": "ipv6",
    "title": "IPv6 addressing",
    "device": "Router",
    "task": "Enable IPv6 routing and assign 2001:db8:10::1/64 on G0/0.",
    "commands": [
      "enable",
      "configure terminal",
      "ipv6 unicast-routing",
      "interface gigabitethernet0/0",
      "ipv6 address 2001:db8:10::1/64",
      "no shutdown",
      "end",
      "show ipv6 interface brief"
    ]
  },
  {
    "id": "voice",
    "title": "Voice VLAN",
    "device": "Switch",
    "task": "Create VLAN 20 and set F0/1 voice VLAN 20.",
    "commands": [
      "enable",
      "configure terminal",
      "vlan 20",
      "exit",
      "interface fastethernet0/1",
      "switchport mode access",
      "switchport voice vlan 20",
      "end",
      "show interfaces switchport"
    ]
  },
  {
    "id": "native",
    "title": "Native VLAN",
    "device": "Switch",
    "task": "Set G0/1 trunk native VLAN 99 (VLAN exists).",
    "commands": [
      "enable",
      "configure terminal",
      "interface gigabitethernet0/1",
      "switchport mode trunk",
      "switchport trunk native vlan 99",
      "end",
      "show interfaces trunk"
    ]
  },
  {
    "id": "svi",
    "title": "Inter-VLAN SVI",
    "device": "Switch",
    "task": "On multilayer switch enable routing, create VLAN 20 and SVI 192.168.20.1/24.",
    "commands": [
      "enable",
      "configure terminal",
      "ip routing",
      "vlan 20",
      "exit",
      "interface vlan 20",
      "ip address 192.168.20.1 255.255.255.0",
      "no shutdown",
      "end",
      "show ip interface brief"
    ]
  },
  {
    "id": "roas",
    "title": "Router on a stick",
    "device": "Router",
    "task": "Configure G0/0.10 for VLAN 10 with 192.168.10.1/24; parent is already up.",
    "commands": [
      "enable",
      "configure terminal",
      "interface gigabitethernet0/0.10",
      "encapsulation dot1q 10",
      "ip address 192.168.10.1 255.255.255.0",
      "end",
      "show ip interface brief"
    ]
  },
  {
    "id": "lldp",
    "title": "CDP and LLDP",
    "device": "Switch",
    "task": "Enable CDP and LLDP globally and verify neighbors.",
    "commands": [
      "enable",
      "configure terminal",
      "cdp run",
      "lldp run",
      "end",
      "show cdp neighbors",
      "show lldp neighbors"
    ]
  },
  {
    "id": "lacp",
    "title": "Layer 2 LACP",
    "device": "Switch",
    "task": "Bundle preconfigured compatible G0/1 into channel 1 in active mode.",
    "commands": [
      "enable",
      "configure terminal",
      "interface gigabitethernet0/1",
      "channel-group 1 mode active",
      "end",
      "show etherchannel summary"
    ]
  },
  {
    "id": "lacp3",
    "title": "Routed EtherChannel",
    "device": "Switch",
    "task": "On a multilayer switch configure G0/1 as routed member of channel 2, then assign port-channel 2 192.0.2.1/30.",
    "commands": [
      "enable",
      "configure terminal",
      "interface gigabitethernet0/1",
      "no switchport",
      "channel-group 2 mode active",
      "exit",
      "interface port-channel 2",
      "no switchport",
      "ip address 192.0.2.1 255.255.255.252",
      "no shutdown",
      "end",
      "show etherchannel summary"
    ]
  },
  {
    "id": "stp",
    "title": "Rapid PVST+ root",
    "device": "Switch",
    "task": "Enable Rapid PVST+ and set root primary for existing VLAN 10.",
    "commands": [
      "enable",
      "configure terminal",
      "spanning-tree mode rapid-pvst",
      "spanning-tree vlan 10 root primary",
      "end",
      "show spanning-tree vlan 10"
    ]
  },
  {
    "id": "stpguard",
    "title": "PortFast and BPDU guard",
    "device": "Switch",
    "task": "On edge F0/1 enable PortFast and BPDU guard.",
    "commands": [
      "enable",
      "configure terminal",
      "interface fastethernet0/1",
      "spanning-tree portfast",
      "spanning-tree bpduguard enable",
      "end",
      "show spanning-tree interface fastethernet0/1 detail"
    ]
  },
  {
    "id": "rootguard",
    "title": "Root guard",
    "device": "Switch",
    "task": "Enable root guard on designated downstream G0/1.",
    "commands": [
      "enable",
      "configure terminal",
      "interface gigabitethernet0/1",
      "spanning-tree guard root",
      "end",
      "show spanning-tree inconsistentports"
    ]
  },
  {
    "id": "route6",
    "title": "IPv6 static routes",
    "device": "Router",
    "task": "Configure default via 2001:db8:1::2 and host route to 2001:db8:2::5 via same next hop.",
    "commands": [
      "enable",
      "configure terminal",
      "ipv6 unicast-routing",
      "ipv6 route ::/0 2001:db8:1::2",
      "ipv6 route 2001:db8:2::5/128 2001:db8:1::2",
      "end",
      "show ipv6 route"
    ]
  },
  {
    "id": "float",
    "title": "Floating and host routes",
    "device": "Router",
    "task": "Set default via 192.0.2.2, backup via 198.51.100.2 with AD 200, host 203.0.113.5 via primary.",
    "commands": [
      "enable",
      "configure terminal",
      "ip route 0.0.0.0 0.0.0.0 192.0.2.2",
      "ip route 0.0.0.0 0.0.0.0 198.51.100.2 200",
      "ip route 203.0.113.5 255.255.255.255 192.0.2.2",
      "end",
      "show ip route"
    ]
  },
  {
    "id": "ospfp2p",
    "title": "OSPF point-to-point",
    "device": "Router",
    "task": "On G0/0 enable OSPF process 1 area 0 and point-to-point network type.",
    "commands": [
      "enable",
      "configure terminal",
      "interface gigabitethernet0/0",
      "ip ospf 1 area 0",
      "ip ospf network point-to-point",
      "end",
      "show ip ospf neighbor"
    ]
  },
  {
    "id": "ospfdr",
    "title": "OSPF DR priority",
    "device": "Router",
    "task": "Set G0/0 OSPF priority to 100 on an existing broadcast OSPF segment.",
    "commands": [
      "enable",
      "configure terminal",
      "interface gigabitethernet0/0",
      "ip ospf priority 100",
      "end",
      "show ip ospf interface gigabitethernet0/0"
    ]
  },
  {
    "id": "ospf3",
    "title": "OSPFv3 IPv6",
    "device": "Router",
    "task": "On IOS with IPv6 OSPF support, enable IPv6 routing, configure process 1 router ID 1.1.1.1 and area 0 on G0/0 (address already set).",
    "commands": [
      "enable",
      "configure terminal",
      "ipv6 unicast-routing",
      "ipv6 router ospf 1",
      "router-id 1.1.1.1",
      "exit",
      "interface gigabitethernet0/0",
      "ipv6 ospf 1 area 0",
      "end",
      "show ipv6 ospf neighbor"
    ]
  },
  {
    "id": "natstatic",
    "title": "Static NAT",
    "device": "Router",
    "task": "Map 192.168.10.10 to 203.0.113.10; G0/0 inside, G0/1 outside.",
    "commands": [
      "enable",
      "configure terminal",
      "interface gigabitethernet0/0",
      "ip nat inside",
      "exit",
      "interface gigabitethernet0/1",
      "ip nat outside",
      "exit",
      "ip nat inside source static 192.168.10.10 203.0.113.10",
      "end",
      "show ip nat translations"
    ]
  },
  {
    "id": "natpool",
    "title": "Dynamic NAT pool",
    "device": "Router",
    "task": "With inside/outside interfaces already configured, match 192.168.10.0/24 using ACL 1 and pool PUBLIC 203.0.113.10–20 /24.",
    "commands": [
      "enable",
      "configure terminal",
      "access-list 1 permit 192.168.10.0 0.0.0.255",
      "ip nat pool PUBLIC 203.0.113.10 203.0.113.20 netmask 255.255.255.0",
      "ip nat inside source list 1 pool PUBLIC",
      "end",
      "show ip nat statistics"
    ]
  },
  {
    "id": "pat",
    "title": "PAT overload",
    "device": "Router",
    "task": "With interfaces already marked inside/outside, overload ACL 1 for 192.168.10.0/24 on G0/1.",
    "commands": [
      "enable",
      "configure terminal",
      "access-list 1 permit 192.168.10.0 0.0.0.255",
      "ip nat inside source list 1 interface gigabitethernet0/1 overload",
      "end",
      "show ip nat translations"
    ]
  },
  {
    "id": "ntp",
    "title": "NTP client and server",
    "device": "Router",
    "task": "In isolated lab set NTP master stratum 5 and upstream server 192.0.2.10.",
    "commands": [
      "enable",
      "configure terminal",
      "ntp master 5",
      "ntp server 192.0.2.10",
      "end",
      "show ntp associations"
    ]
  },
  {
    "id": "relay",
    "title": "DHCP relay",
    "device": "Router",
    "task": "Relay DHCP from G0/0 to 192.0.2.10.",
    "commands": [
      "enable",
      "configure terminal",
      "interface gigabitethernet0/0",
      "ip helper-address 192.0.2.10",
      "end",
      "show running-config interface gigabitethernet0/0"
    ]
  },
  {
    "id": "client",
    "title": "DHCP client",
    "device": "Router",
    "task": "Set G0/1 to DHCP addressing and enable it.",
    "commands": [
      "enable",
      "configure terminal",
      "interface gigabitethernet0/1",
      "ip address dhcp",
      "no shutdown",
      "end",
      "show ip interface brief"
    ]
  },
  {
    "id": "ssh",
    "title": "SSH remote access",
    "device": "Router",
    "task": "Hostname R1, domain lab.example, user admin secret LabPass123, RSA 2048, SSH v2 and VTY 0–4 local SSH only.",
    "commands": [
      "enable",
      "configure terminal",
      "hostname R1",
      "ip domain-name lab.example",
      "username admin secret LabPass123",
      "crypto key generate rsa modulus 2048",
      "ip ssh version 2",
      "line vty 0 4",
      "login local",
      "transport input ssh",
      "end",
      "show ip ssh"
    ]
  },
  {
    "id": "local",
    "title": "Local password protection",
    "device": "Router",
    "task": "Set enable secret LabEnable123, local user admin secret LabPass123, console login local.",
    "commands": [
      "enable",
      "configure terminal",
      "enable secret LabEnable123",
      "username admin secret LabPass123",
      "line console 0",
      "login local",
      "end",
      "show running-config"
    ]
  },
  {
    "id": "acl-ext",
    "title": "Extended named ACL",
    "device": "Router",
    "task": "Allow HTTPS from 192.168.10.0/24 to 203.0.113.5, deny other IP, apply WEB inbound G0/0.",
    "commands": [
      "enable",
      "configure terminal",
      "ip access-list extended WEB",
      "permit tcp 192.168.10.0 0.0.0.255 host 203.0.113.5 eq 443",
      "deny ip any any",
      "exit",
      "interface gigabitethernet0/0",
      "ip access-group WEB in",
      "end",
      "show access-lists"
    ]
  },
  {
    "id": "snoop",
    "title": "DHCP snooping",
    "device": "Switch",
    "task": "Enable snooping for VLAN 10; trust server uplink G0/1.",
    "commands": [
      "enable",
      "configure terminal",
      "ip dhcp snooping",
      "ip dhcp snooping vlan 10",
      "interface gigabitethernet0/1",
      "ip dhcp snooping trust",
      "end",
      "show ip dhcp snooping"
    ]
  },
  {
    "id": "dai",
    "title": "Dynamic ARP inspection",
    "device": "Switch",
    "task": "With DHCP snooping bindings present, enable DAI VLAN 10 and trust uplink G0/1.",
    "commands": [
      "enable",
      "configure terminal",
      "ip arp inspection vlan 10",
      "interface gigabitethernet0/1",
      "ip arp inspection trust",
      "end",
      "show ip arp inspection"
    ]
  },
  {
    "id": "portsec",
    "title": "Port security",
    "device": "Switch",
    "task": "Configure F0/1 access, maximum two secure MACs, sticky learning and restrict violation.",
    "commands": [
      "enable",
      "configure terminal",
      "interface fastethernet0/1",
      "switchport mode access",
      "switchport port-security",
      "switchport port-security maximum 2",
      "switchport port-security mac-address sticky",
      "switchport port-security violation restrict",
      "end",
      "show port-security interface fastethernet0/1"
    ]
  },
  {
    "id": "storm",
    "title": "Storm control",
    "device": "Switch",
    "task": "Limit broadcast traffic on F0/1 to 5 percent.",
    "commands": [
      "enable",
      "configure terminal",
      "interface fastethernet0/1",
      "storm-control broadcast level 5.00",
      "end",
      "show storm-control"
    ]
  },
  {
    "id": "raguard",
    "title": "IPv6 RA guard",
    "device": "Switch",
    "task": "On supported IOS XE configure HOST policy with host role, attach to F0/1.",
    "commands": [
      "enable",
      "configure terminal",
      "ipv6 nd raguard policy HOST",
      "device-role host",
      "exit",
      "interface fastethernet0/1",
      "ipv6 nd raguard attach-policy HOST",
      "end",
      "show ipv6 nd raguard policy"
    ]
  },
  {
    "id": "poe",
    "title": "PoE edge port",
    "device": "Switch",
    "task": "Set F0/1 to automatic power allocation on PoE-capable switch.",
    "commands": [
      "enable",
      "configure terminal",
      "interface fastethernet0/1",
      "power inline auto",
      "end",
      "show power inline"
    ]
  },
  {
    "id": "radius",
    "title": "RADIUS AAA client",
    "device": "Router",
    "task": "With console access, define RADIUS server LAB at 192.0.2.20 auth 1812 acct 1813, key LabKey123, and default login RADIUS with local fallback (local account preconfigured).",
    "commands": [
      "enable",
      "configure terminal",
      "aaa new-model",
      "radius server LAB",
      "address ipv4 192.0.2.20 auth-port 1812 acct-port 1813",
      "key LabKey123",
      "exit",
      "aaa authentication login default group radius local",
      "end",
      "show aaa servers"
    ]
  },
  {
    "id": "tacacs",
    "title": "TACACS+ AAA client",
    "device": "Router",
    "task": "With console access, define TACACS server LAB at 192.0.2.21 key LabKey123, default login TACACS with local fallback (local account preconfigured).",
    "commands": [
      "enable",
      "configure terminal",
      "aaa new-model",
      "tacacs server LAB",
      "address ipv4 192.0.2.21",
      "key LabKey123",
      "exit",
      "aaa authentication login default group tacacs+ local",
      "end",
      "show aaa servers"
    ]
  },
  {
    "id": "scp",
    "title": "SCP server setup",
    "device": "Router",
    "task": "With SSH and local AAA already configured, enable SCP server.",
    "commands": [
      "enable",
      "configure terminal",
      "ip scp server enable",
      "end",
      "show running-config"
    ]
  }
]